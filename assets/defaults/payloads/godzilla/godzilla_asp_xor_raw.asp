'   response : xor(result)
Function MxXor(ByVal vData, ByVal vKey, ByVal vBinary)
    Dim i, size, keySize, stream
    keySize = Len(vKey)
    size = LenB(vData)
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2
    stream.Charset = "iso-8859-1"
    stream.Open
    For i = 1 To size
        Dim b, k
        b = AscB(MidB(vData, i, 1)) And &HFF
        k = Asc(Mid(vKey, (i Mod keySize) + 1, 1))
        stream.WriteText ChrW((b Xor k) And &HFF)
    Next
    stream.Position = 0
    If vBinary Then
        stream.Type = 1
        MxXor = stream.Read()
    Else
        MxXor = stream.ReadText()
    End If
    stream.Close
    Set stream = Nothing
End Function

