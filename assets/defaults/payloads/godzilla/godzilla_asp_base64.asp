'
' No encryption: the body is plain base64(params).
Function MxB64Decode(ByVal vCode)
    Dim xml, node
    Set xml = CreateObject("Msxml2.DOMDocument.3.0")
    Set node = xml.CreateElement("base64")
    node.dataType = "bin.base64"
    node.text = vCode
    MxB64Decode = node.nodeTypedValue
    Set node = Nothing
    Set xml = Nothing
End Function

Function MxB64Encode(ByVal vData)
    Dim xml, node
    Set xml = CreateObject("Msxml2.DOMDocument.3.0")
    Set node = xml.CreateElement("base64")
    node.dataType = "bin.base64"
    node.nodeTypedValue = vData
    MxB64Encode = Replace(node.text, vbLf, "")
    Set node = Nothing
    Set xml = Nothing
End Function

Function MxToBinary(ByVal vText)
    Dim stream
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2
    stream.Charset = "iso-8859-1"
    stream.Open
    stream.WriteText vText
    stream.Position = 0
    stream.Type = 1
    MxToBinary = stream.Read()
    stream.Close
    Set stream = Nothing
End Function

Function MxToText(ByVal vData)
    Dim stream
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 1
    stream.Open
    stream.Write vData
    stream.Position = 0
    stream.Type = 2
    stream.Charset = "iso-8859-1"
    MxToText = stream.ReadText()
    stream.Close
    Set stream = Nothing
End Function

Dim mxPass, mxData
